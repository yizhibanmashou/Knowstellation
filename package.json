{
  "name": "knowstellation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:data": "node scripts/sync-frontend-data.mjs",
    "concept:graph": "node scripts/generate-concept-graph.mjs && node scripts/build-concept-search-index.mjs",
    "concept:search": "node scripts/build-concept-search-index.mjs",
    "concept:extract": "node scripts/concept_extraction/cli.mjs",
    "concept:merge": "node scripts/build-concept-merge-candidates.mjs",
    "concept:merge:apply": "node scripts/apply-concept-merge-candidates.mjs",
    "concept:merge:prepare-llm": "node scripts/prepare-concept-merge-llm-batches.mjs",
    "concept:merge:import-llm": "node scripts/import-concept-merge-llm-results.mjs",
    "concept:review:auto-fix": "node scripts/auto-fix-concept-review.mjs scan",
    "concept:review:prepare-llm": "node scripts/prepare-concept-llm-batches.mjs",
    "concept:review:run-llm": "node scripts/run-concept-llm-batches.mjs",
    "concept:review:collect-llm": "node scripts/collect-concept-llm-results.mjs",
    "concept:review:import-llm": "node scripts/auto-fix-concept-review.mjs import-llm-results",
    "concept:review:pipeline": "node scripts/concept-review-pipeline.mjs",
    "concept:review:audit": "node scripts/audit-concept-review.mjs",
    "concept:graph:audit": "node scripts/audit-concept-graph-health.mjs",
    "concept:review:apply": "node scripts/apply-concept-review-patch.mjs",
    "concept:review:dev": "node tools/concept-review/server.mjs",
    "release:audit": "node scripts/audit-product-release.mjs",
    "release:check": "npm run concept:graph && npm run sync:data && npm run release:audit && npm run test:node && npm run build && npm run test:e2e && npm run test:python",
    "llm:cache": "node scripts/generate-llm-cache.mjs",
    "images:storylines": "node scripts/optimize-storyline-images.mjs",
    "symbol-sense": "node scripts/symbol_sense/cli.mjs",
    "audit:graph": "python scripts/audit_dependency_graph.py",
    "test:node": "node --test test\\*.test.ts",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:e2e": "playwright test",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run images:storylines && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.6",
    "fuse.js": "^7.0.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.171.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
